<Window x:Class="ApparelPOS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ApparelPOS.ViewModels"
        xmlns:views="clr-namespace:ApparelPOS.Views"
        mc:Ignorable="d"
        Title="Velvet Thread ApparelPOS - Enterprise Offline Retail System"
        Height="720" Width="1180"
        MinHeight="540" MinWidth="850"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="/Assets/app_icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- DataTemplates mapping ViewModels to Views -->
        <DataTemplate DataType="{x:Type vm:BillingViewModel}">
            <views:BillingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BarcodeGeneratorViewModel}">
            <views:BarcodeGeneratorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Navigation & Status Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Store Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#312E81" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="👔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="APPARELPOS" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding StoreName}" FontSize="11" Foreground="{StaticResource PrimaryLightBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center: Hardware License Security Badge -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="20" Padding="12,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LicenseBadge}" FontWeight="Bold" FontSize="11" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding OpenActivationCommand}" Content="⚡ Activate ₹249/yr" Padding="10,4" Margin="0,0,10,0" Style="{StaticResource PrimaryButton}" FontSize="11"/>
                    <Border Background="#1E293B" CornerRadius="20" Padding="10,4">
                        <TextBlock Text="100% OFFLINE AIR-GAPPED" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Right: Cashier Info & Live Clock -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Right" Margin="0,0,14,0">
                        <TextBlock Text="{Binding CashierName}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding CurrentTime}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Background="#334155" CornerRadius="18" Width="34" Height="34">
                        <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace (Sidebar + Active View) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="MAIN MENU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="18,0,0,12"/>

                        <!-- POS Billing Nav Button -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToBillingCommand}">
                            <Button.Tag>
                                <Binding Path="IsBillingActive">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </Button.Tag>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒" Margin="0,0,12,0"/>
                                <TextBlock Text="POS Checkout"/>
                            </StackPanel>
                        </Button>

                        <!-- Inventory Nav Button -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToInventoryCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" Margin="0,0,12,0"/>
                                <TextBlock Text="Apparel Catalog"/>
                            </StackPanel>
                        </Button>

                        <!-- Barcode Generator Nav Button -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToBarcodeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏷️" Margin="0,0,12,0"/>
                                <TextBlock Text="Barcode Labels"/>
                            </StackPanel>
                        </Button>

                        <!-- Analytics Nav Button -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToAnalyticsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" Margin="0,0,12,0"/>
                                <TextBlock Text="Sales Analytics"/>
                            </StackPanel>
                        </Button>

                        <Separator Background="{StaticResource BorderBrush}" Margin="16,16,16,16"/>

                        <!-- Settings Nav Button -->
                        <Button Style="{StaticResource NavButton}" Command="{Binding NavigateToSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" Margin="0,0,12,0"/>
                                <TextBlock Text="System Setup"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Offline Notice -->
                    <Border Grid.Row="1" Background="{StaticResource BgInputBrush}" CornerRadius="8" Margin="14" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Hardware-Locked" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}"/>
                            <TextBlock Text="RSA-2048 Cryptography" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="Crash-safe SQLite WAL" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Dynamic Active View Workspace -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
