<UserControl x:Class="ApparelPOS.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApparelPOS.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Main POS Grid Layout -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Action & Scanner Bar -->
            <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="12,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Barcode Input Box with HID Scanner Listener + Manual Search + Laptop Camera -->
                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#312E81" CornerRadius="6,0,0,6" Padding="12,8">
                            <TextBlock Text="🏷️ SCAN / SEARCH" FontWeight="Bold" FontSize="11" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                        </Border>

                        <TextBox x:Name="TxtBarcode" Grid.Column="1" Text="{Binding BarcodeQuery, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" FontWeight="SemiBold" Padding="12,8"
                                 BorderThickness="1,1,0,1"
                                 KeyDown="TxtBarcode_KeyDown"/>

                        <Button Grid.Column="2" Command="{Binding ProcessScanCommand}" Content="Add / Enter" 
                                Style="{StaticResource PrimaryButton}" Padding="14,8" Margin="0,0,8,0"
                                BorderThickness="0,1,1,1"/>

                        <Button Grid.Column="3" Command="{Binding OpenCatalogModalCommand}" Style="{StaticResource SuccessButton}" Padding="12,8" Margin="0,0,8,0"
                                ToolTip="Browse full clothing catalog and manually click to add items without a barcode scanner (F3)">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource KeyBadge}" Margin="0,0,6,0"><TextBlock Text="F3" Foreground="#FFF" FontWeight="Bold" FontSize="10"/></Border>
                                <TextBlock Text="📦 Manual Picker" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4" Command="{Binding ToggleCameraScannerCommand}" Style="{StaticResource PrimaryButton}" Background="#4F46E5" Padding="12,8"
                                ToolTip="Scan apparel tags using your laptop/webcam camera (F4)">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource KeyBadge}" Margin="0,0,6,0"><TextBlock Text="F4" Foreground="#FFF" FontWeight="Bold" FontSize="10"/></Border>
                                <TextBlock Text="📷 Laptop Camera" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Quick Function Keys -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding NewBillCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource KeyBadge}"><TextBlock Text="F1" Foreground="#FFF" FontWeight="Bold" FontSize="10"/></Border>
                                <TextBlock Text="New Bill" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ToggleUpiModalCommand}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource KeyBadge}"><TextBlock Text="F8" Foreground="#FFF" FontWeight="Bold" FontSize="10"/></Border>
                                <TextBlock Text="UPI QR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowReceiptPreviewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👁️ Receipt Preview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area: Left Cart (70%) + Right Payment/Summary (30%) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Active Cart DataGrid & Customer Bar -->
                <Grid Grid.Column="0" Margin="0,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Customer Information Strip -->
                    <Border Grid.Row="0" Style="{StaticResource CardSubtle}" Margin="0,0,0,8" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Customer Name:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" Padding="8,4"/>

                            <TextBlock Grid.Column="2" Text="Mobile No:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" Padding="8,4"/>
                        </Grid>
                    </Border>

                    <!-- Cart DataGrid -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="0">
                        <DataGrid ItemsSource="{Binding CartItems}" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <!-- Item Name & Sku -->
                                <DataGridTemplateColumn Header="APPAREL ITEM" Width="2.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding Sku}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Size & Color Badges -->
                                <DataGridTemplateColumn Header="SIZE / COLOR" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#312E81" CornerRadius="4" Padding="6,2" Margin="0,0,4,0">
                                                    <TextBlock Text="{Binding Size}" FontWeight="Bold" FontSize="11" Foreground="#C7D2FE"/>
                                                </Border>
                                                <Border Background="#1E293B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Color}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Quantity Controls -->
                                <DataGridTemplateColumn Header="QTY" Width="1.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="-" Command="{Binding DataContext.DecrementQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" Width="26" Height="26" Padding="0" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding Quantity}" FontWeight="Bold" Width="24" TextAlignment="Center" VerticalAlignment="Center"/>
                                                <Button Content="+" Command="{Binding DataContext.IncrementQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" Width="26" Height="26" Padding="0" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit Price -->
                                <DataGridTextColumn Header="RATE" Binding="{Binding UnitPrice, StringFormat='₹{0:N2}'}" Width="1*" FontWeight="SemiBold"/>

                                <!-- Discount % -->
                                <DataGridTemplateColumn Header="DISC %" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}"
                                                     Width="50" HorizontalAlignment="Left" Padding="4,2"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total Price -->
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalPrice, StringFormat='₹{0:N2}'}" Width="1.2*" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>

                                <!-- Remove Action -->
                                <DataGridTemplateColumn Header="" Width="0.6*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource DangerButton}"
                                                    Width="28" Height="28" Padding="0" ToolTip="Remove from bill"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Right: Billing Totals & Payment Summary -->
                <Border Grid.Column="1" Style="{StaticResource CardPanel}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <TextBlock Grid.Row="0" Text="CHECKOUT SUMMARY" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,14"/>

                        <!-- Calculations Area -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Subtotal -->
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Sub Total:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SubTotal, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                </Grid>

                                <!-- Bill Discount -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Bill Disc %:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource KeyBadge}" Margin="6,0,0,0"><TextBlock Text="F5" FontSize="9" Foreground="#FFF"/></Border>
                                    </StackPanel>
                                    <TextBox Text="{Binding BillDiscountPercent, UpdateSourceTrigger=PropertyChanged}" Width="70" HorizontalAlignment="Right" Padding="6,3"/>
                                </Grid>

                                <!-- Tax Breakdown (GST: CGST + SGST) -->
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="CGST (2.5%):" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding CgstAmount, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="SGST (2.5%):" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding SgstAmount, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Round Off:" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding RoundOff, StringFormat='₹{0:+0.00;-0.00;0.00}'}" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,14"/>

                                <!-- Grand Total Box -->
                                <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                    <Grid>
                                        <TextBlock Text="GRAND TOTAL" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding GrandTotal, StringFormat='₹{0:N2}'}" FontWeight="Bold" FontSize="26" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Payment Method Tabs -->
                                <TextBlock Text="PAYMENT MODE:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0" Content="💵 Cash" IsChecked="{Binding IsCashPayment, Mode=OneWay}"
                                                 GroupName="PayMethod" Margin="0,0,4,0" Click="PayCash_Click"/>
                                    <RadioButton Grid.Column="1" Content="💳 Card" IsChecked="{Binding PaymentMethod, Converter={x:Null}, Mode=OneWay}"
                                                 GroupName="PayMethod" Margin="0,0,4,0" Click="PayCard_Click"/>
                                    <RadioButton Grid.Column="2" Content="📱 UPI/QR" IsChecked="{Binding IsUpiPayment, Mode=OneWay}"
                                                 GroupName="PayMethod" Click="PayUpi_Click"/>
                                </Grid>

                                <!-- Cash Received and Change Due Panel -->
                                <StackPanel Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Cash Received:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:0.##}'}"
                                                 Width="110" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Padding="8,4"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Change Due:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding ChangeDue, StringFormat='₹{0:N2}'}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="16" Foreground="{StaticResource WarningBrush}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- UPI Static QR Info -->
                                <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,14"
                                        Visibility="{Binding IsUpiPayment, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="UPI Instant Payment" FontWeight="Bold" Foreground="#A5B4FC" FontSize="12"/>
                                        <TextBlock Text="Customer can scan the screen QR code or thermal receipt to pay directly." FontSize="11" Foreground="#C7D2FE" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                        <Button Command="{Binding ToggleUpiModalCommand}" Content="📲 Open Full-Screen QR Code" Style="{StaticResource PrimaryButton}" Padding="10,6" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Huge Checkout Button [F9] -->
                        <Button Grid.Row="2" Command="{Binding CheckoutAndPrintCommand}" Style="{StaticResource SuccessButton}"
                                Height="54" FontSize="16" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource KeyBadge}"><TextBlock Text="F9" FontSize="12" Foreground="#FFF" FontWeight="Bold"/></Border>
                                <TextBlock Text="CHECKOUT &amp; PRINT RECEIPT" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Status Toast Bar -->
            <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryLightBrush}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Shortcuts: [F1] New Bill | [F3] Manual Item Picker | [F5] Discount | [F8] UPI QR | [F9] Checkout" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>

        <!-- UPI QR Code Full Modal Overlay -->
        <Border Background="#CC000000" Visibility="{Binding IsUpiModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardPanel}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="SCAN &amp; PAY VIA UPI" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Any UPI App: GPay, PhonePe, Paytm, BHIM" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <Border Background="#FFFFFF" Padding="12" CornerRadius="8" HorizontalAlignment="Center" Margin="0,0,0,14" Width="264" Height="264">
                        <Grid>
                            <Image Source="{Binding UpiQrCodeSource}" Width="240" Height="240"
                                   Visibility="{Binding HasUpiQrCode, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasUpiError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="⚠️" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding UpiErrorMessage}"
                                           Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold"
                                           TextWrapping="Wrap" TextAlignment="Center" Width="220"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding UpiPayeeDisplay}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="{Binding GrandTotal, StringFormat='AMOUNT: ₹{0:N2}'}" FontWeight="Bold" FontSize="22" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,18"/>

                    <Button Command="{Binding ToggleUpiModalCommand}" Content="Close QR Dialog" Style="{StaticResource PrimaryButton}" Padding="20,10" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Receipt Monospace Preview Modal Overlay -->
        <Border Background="#CC000000" Visibility="{Binding IsReceiptPreviewOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardPanel}" Width="450" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="THERMAL RECEIPT PREVIEW (80mm/58mm)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReceiptPreviewText}" FontFamily="Consolas" FontSize="12" Foreground="#000000"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Command="{Binding CloseReceiptPreviewCommand}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="📄 Print / Save as PDF" Command="{Binding WindowsPrintCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="🖨️ Thermal Printer" Command="{Binding PrintReceiptPreviewCommand}" Style="{StaticResource SuccessButton}" Padding="14,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Manual Item Picker & Catalog Browser Modal Overlay -->
        <Border Background="#CC000000" Visibility="{Binding IsCatalogModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardPanel}" Width="840" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="📦 MANUAL ITEM PICKER (APPAREL CATALOG)" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                            <TextBlock Text="Browse garments by name, SKU, or category and add to bill with 1-click (no barcode scanner needed)"
                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseCatalogModalCommand}" Content="✕ Close" Padding="12,5"/>
                    </Grid>

                    <!-- Search & Filter Bar -->
                    <Border Grid.Row="1" Background="{StaticResource BgInputBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding CatalogSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="10,6" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CatalogCategories}" SelectedItem="{Binding SelectedCatalogCategory}"/>
                        </Grid>
                    </Border>

                    <!-- Catalog Items Grid -->
                    <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="0" Margin="0,0,0,12">
                        <DataGrid ItemsSource="{Binding FilteredCatalogItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding Name}" Width="2.2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1.2*"/>
                                <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="1*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="COLOR" Binding="{Binding Color}" Width="1.2*"/>
                                <DataGridTextColumn Header="PRICE" Binding="{Binding Price, StringFormat='₹{0:N2}'}" Width="1*" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                <DataGridTextColumn Header="STOCK" Binding="{Binding Stock, StringFormat='{}{0} pcs'}" Width="0.9*"/>
                                <DataGridTemplateColumn Header="ACTION" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="➕ Add to Cart" Command="{Binding DataContext.AddPickerItemToCartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource SuccessButton}" Padding="10,4" FontSize="11" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Footer -->
                    <Grid Grid.Row="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Items in Cart: " Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CartItems.Count}" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,16,0"/>
                            <TextBlock Text="Cart Grand Total: " Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat='₹{0:N2}'}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Command="{Binding CloseCatalogModalCommand}" Content="✓ Return to Checkout" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Live Laptop Camera Barcode Scanner Modal Overlay -->
        <Border Background="#D9000000" Visibility="{Binding IsCameraScannerOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardPanel}" Width="680" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📷 LAPTOP CAMERA BARCODE SCANNER" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF"/>
                                <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="LIVE" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Hold garment barcode tag up to the webcam. It scans automatically with an audio beep."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseCameraScannerCommand}" Content="✕ Close (Esc)" Padding="14,6"/>
                    </Grid>

                    <!-- Video Viewfinder Frame with Target Reticle & Laser Line -->
                    <Border Grid.Row="1" Background="#050814" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="10" MinHeight="380" MaxHeight="400" ClipToBounds="True" Margin="0,0,0,14">
                        <Grid>
                            <!-- Camera Video Feed -->
                            <Image Source="{Binding CameraFrameSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Fallback / Loading indicator if no frame yet -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoCameraFrame, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="🎥" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding CameraStatusText}" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Optical Aiming Reticle (Green corners + subtle crosshair) -->
                            <Grid Width="280" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <!-- Top-Left Corner -->
                                <Border BorderBrush="#10B981" BorderThickness="3,3,0,0" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4,0,0,0"/>
                                <!-- Top-Right Corner -->
                                <Border BorderBrush="#10B981" BorderThickness="0,3,3,0" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="0,4,0,0"/>
                                <!-- Bottom-Left Corner -->
                                <Border BorderBrush="#10B981" BorderThickness="3,0,0,3" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="0,0,0,4"/>
                                <!-- Bottom-Right Corner -->
                                <Border BorderBrush="#10B981" BorderThickness="0,0,3,3" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="0,0,4,0"/>

                                <!-- Center Red Laser Scan Guide Line -->
                                <Rectangle Height="2" Fill="#EF4444" VerticalAlignment="Center" Opacity="0.85" Margin="10,0"/>

                                <TextBlock Text="ALIGN BARCODE HERE" Foreground="#A7F3D0" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            </Grid>

                            <!-- Scanned Feedback Popup Overlay inside Viewfinder -->
                            <Border CornerRadius="8" Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16"
                                    MaxWidth="560"
                                    Visibility="{Binding HasCameraScanFeedback, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F2047857"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CameraScanSuccess}" Value="False">
                                                <Setter Property="Background" Value="#F2B91C1C"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CameraScanFeedback}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" 
                                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock Text="⚠️ This barcode is not registered in your Products or Inventory. Please add this product in Inventory first." 
                                               FontSize="11" Foreground="#FEF08A" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CameraScanSuccess}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Modal Controls Footer -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CameraStatusText}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            <CheckBox IsChecked="{Binding AutoCloseCameraAfterScan}" Margin="0,6,0,0"
                                      ToolTip="Automatically return to bill checkout screen as soon as a barcode is scanned">
                                <TextBlock Text="Close camera automatically after successful scan" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </CheckBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding CloseCameraScannerCommand}" Style="{StaticResource SuccessButton}" Content="Done / Back to POS" Padding="18,8"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
