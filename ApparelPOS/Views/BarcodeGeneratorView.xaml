<UserControl x:Class="ApparelPOS.Views.BarcodeGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApparelPOS.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🏷️ APPAREL THERMAL BARCODE &amp; PRICE TAG GENERATOR" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                    <TextBlock Text="Render Code 128 barcodes, preview 50mm x 25mm tags, and dispatch direct to USB thermal label printers"
                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Main Content Area: Left Configuration + Right Preview & TSPL -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Selection & Print Controls -->
                <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,14,0" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="1. SELECT APPAREL MASTER PRODUCT" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Command="{Binding RefreshProductsCommand}" Content="🔄 Refresh List" Padding="8,3" FontSize="11"/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" Margin="0,0,0,14"/>

                        <TextBlock Text="2. SELECT VARIANT (SIZE / COLOR)" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Variants}" SelectedItem="{Binding SelectedVariant}" DisplayMemberPath="DisplayName" Margin="0,0,0,14"/>

                        <TextBlock Text="3. NUMBER OF LABEL COPIES TO PRINT" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding PrintCopies, UpdateSourceTrigger=PropertyChanged}" FontSize="14" FontWeight="Bold" Margin="0,0,0,18"/>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                        <Button Command="{Binding PrintLabelCommand}" Style="{StaticResource SuccessButton}" Height="42" FontSize="12.5" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️ PRINT (WINDOWS PRINT DIALOG)" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenBrowserPrintPreviewCommand}" Style="{StaticResource PrimaryButton}" Height="40" FontSize="12" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 OPEN IN BROWSER / PDF PRINT PREVIEW" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Opens the Windows Print dialog or Edge print preview so you can choose your HP Neverstop Laser printer or PDF and print." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Right: Visual Label Preview & TSPL Output -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Visual Label Preview Card (Garment Tag Simulation) -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="LIVE THERMAL LABEL PREVIEW (50mm x 25mm)" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,10"/>

                            <!-- Simulated White Thermal Label Canvas -->
                            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="6"
                                    Width="340" Height="170" HorizontalAlignment="Center" Padding="14,10">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Store Header -->
                                    <TextBlock Text="{Binding StoreName}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" HorizontalAlignment="Center"/>

                                    <!-- Product Title -->
                                    <TextBlock Text="{Binding PreviewTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                    <!-- Size & Color -->
                                    <TextBlock Text="{Binding PreviewDetails}" FontSize="10.5" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                    <!-- MRP -->
                                    <TextBlock Text="{Binding PreviewPrice}" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,2,0,4"/>

                                    <!-- Barcode Image -->
                                    <Border Margin="0,2,0,0" HorizontalAlignment="Center">
                                        <Image Source="{Binding BarcodeImageSource}" Width="220" Height="45" Stretch="Uniform"/>
                                    </Border>

                                    <!-- Human readable barcode -->
                                    <TextBlock Text="{Binding PreviewBarcode}" FontFamily="Consolas" FontSize="9.5" Foreground="#334155" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- TSPL Direct Commands Panel -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAW TSPL / ESC-POS COMMAND SCRIPT" FontWeight="Bold" FontSize="11.5" Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding CopyTsplCommand}" Content="📋 Copy Script" Padding="8,3" FontSize="11"/>
                            </Grid>

                            <Border Grid.Row="1" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" MinHeight="100">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding TsplScript}" FontFamily="Consolas" FontSize="11" Foreground="#A5B4FC"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,10,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryLightBrush}" FontWeight="SemiBold" FontSize="12"/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
