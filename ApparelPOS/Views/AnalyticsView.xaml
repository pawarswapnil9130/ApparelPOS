<UserControl x:Class="ApparelPOS.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ApparelPOS.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Filter -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📊 OFFLINE SALES ANALYTICS &amp; LOCAL REPORTING" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF"/>
                    <TextBlock Text="Local profit &amp; loss calculations, fast-moving apparel sizes, and receipt reprinting" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Period:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                    <ComboBox Width="130" SelectedItem="{Binding SelectedPeriod}" Margin="0,0,10,0">
                        <ComboBoxItem Content="Today" IsSelected="True"/>
                        <ComboBoxItem Content="Yesterday"/>
                        <ComboBoxItem Content="Last 7 Days"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="All Time"/>
                    </ComboBox>
                    <Button Command="{Binding RefreshCommand}" Content="🔄 Refresh Data" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4 KPI Metrics Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Revenue -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,10,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="TOTAL REVENUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryLightBrush}"/>
                    <TextBlock Text="{Binding TotalRevenue, StringFormat='₹{0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding ItemsSold, StringFormat='{}{0} Apparel Units Sold'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Gross Profit -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="0,0,10,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="ESTIMATED PROFIT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="{Binding GrossProfit, StringFormat='₹{0:N2}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding ProfitMarginPercent, StringFormat='Margin: {0:F1}% (Rev - Cost)'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Total Invoices -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}" Margin="0,0,10,0" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="COMPLETED INVOICES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="{Binding TotalInvoices}" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,2"/>
                    <TextBlock Text="100% Offline Transactions" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Payment Breakdown -->
            <Border Grid.Column="3" Style="{StaticResource CardPanel}" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="PAYMENT SPLIT" FontSize="11" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="💵 Cash:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CashCollected, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="💳 Card:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding CardCollected, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="📱 UPI:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding UpiCollected, StringFormat='₹{0:N2}'}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content: Left Analytics (Sizes/Categories) + Right Invoices Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Top Apparel Sizes & Categories -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Sizes Table -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="👕 FASTEST-MOVING APPAREL SIZES" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding TopSizes}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SIZE" Binding="{Binding Size}" Width="1*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="QTY SOLD" Binding="{Binding QuantitySold}" Width="1*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="REVENUE" Binding="{Binding Revenue, StringFormat='₹{0:N2}'}" Width="1.5*" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Top Categories Table -->
                <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="🏷️ BEST-SELLING CATEGORIES" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,8"/>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding TopCategories}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1.5*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="UNITS" Binding="{Binding QuantitySold}" Width="1*"/>
                                <DataGridTextColumn Header="REVENUE" Binding="{Binding Revenue, StringFormat='₹{0:N2}'}" Width="1.5*" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Invoices List with 1-Click Thermal Reprint -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter / Search Invoices -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding InvoiceSearch, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,8,0">
                            <TextBox.Resources>
                                <VisualBrush x:Key="HintBrush" TileMode="None" Stretch="None" AlignmentX="Left">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="🔍 Search Invoice #, Customer Name, Phone..." Foreground="{StaticResource TextMutedBrush}"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock Grid.Column="1" Text="SALES INVOICES HISTORY" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Invoices DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="INVOICE #" Binding="{Binding InvoiceNumber}" Width="1.5*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="DATE / TIME" Binding="{Binding InvoiceDate, StringFormat='{}{0:dd-MMM HH:mm}'}" Width="1.3*"/>
                            <DataGridTextColumn Header="CUSTOMER" Binding="{Binding CustomerName}" Width="1.5*"/>
                            <DataGridTextColumn Header="PAY VIA" Binding="{Binding PaymentMethod}" Width="1*"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat='₹{0:N2}'}" Width="1.2*" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>

                            <!-- 1-Click Reprint Receipt Button -->
                            <DataGridTemplateColumn Header="ACTION" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🖨️ Reprint" Command="{Binding DataContext.ReprintReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Padding="8,4" FontSize="11" Style="{StaticResource PrimaryButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryLightBrush}" FontWeight="SemiBold"/>
        </Border>

        <!-- Thermal Receipt Preview Modal Overlay for Reprint -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#CC000000" Visibility="{Binding IsReceiptPreviewOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource CardPanel}" Width="450" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="THERMAL RECEIPT REPRINT PREVIEW" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,12"/>

                    <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReceiptPreviewText}" FontFamily="Consolas" FontSize="12" Foreground="#000000"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Close" Command="{Binding CloseReceiptPreviewCommand}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="📄 Print / Save as PDF" Command="{Binding WindowsPrintCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,8"/>
                        <Button Content="🖨️ Thermal Printer" Command="{Binding PrintReceiptPreviewCommand}" Style="{StaticResource SuccessButton}" Padding="14,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
