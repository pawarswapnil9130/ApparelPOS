<Window x:Class="ApparelPOS.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ApparelPOS.ViewModels"
        mc:Ignorable="d"
        Title="ApparelPOS - 1-Year Commercial License Activation"
        Height="680" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="/Assets/app_icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource CardPanel}" Padding="30" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Header -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="#312E81" Width="50" Height="50" CornerRadius="12" Margin="0,0,16,0">
                        <TextBlock Text="🛡️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="ApparelPOS License Activation" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{Binding HeaderSubtitle}" FontSize="13" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,18"/>

                <!-- Row 2: Two Column Body -->
                <Grid Grid.Row="2" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Automated Payment via QR Code -->
                    <Border Grid.Column="0" Background="#1E293B" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="12" Padding="18">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Background="#10B981" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="₹249 / 1 YEAR (AUTO-KEY)" FontWeight="Bold" FontSize="12" Foreground="#042F2E"/>
                            </Border>

                            <!-- White background container for QR code scanning -->
                            <Border Background="#FFFFFF" CornerRadius="8" Padding="10" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Image Source="{Binding QrCodeImageSource}" Width="160" Height="160"/>
                            </Border>

                            <TextBlock Text="📱 HOW TO GET YOUR KEY:" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                            <TextBlock Text="1. Scan QR with Phone Camera, Google Lens, or Paytm" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="2. Pay ₹249 with GPay, PhonePe, or UPI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="3. Your 1-Year Key appears instantly on phone screen!" FontSize="11" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="4. Paste key on the right to activate." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Machine Code & License Key Input -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <!-- Machine Code Section -->
                        <TextBlock Text="YOUR PC MACHINE CODE:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryLightBrush}" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding MachineCode}" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding CopyMachineCodeCommand}" Content="📋 Copy Code" Padding="12,6" Style="{StaticResource PrimaryButton}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="🔒 Hardware-locked to this device's Motherboard UUID, CPU, and Disk serial."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                        <!-- License Input Section -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PASTE 1-YEAR LICENSE KEY STRING OR BROWSE FILE:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding BrowseLicenseFileCommand}" Content="📁 Browse .lic File" Padding="10,5"/>
                        </Grid>

                        <TextBox Text="{Binding LicenseInput, UpdateSourceTrigger=PropertyChanged}"
                                 Height="85" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12"/>

                        <!-- Status Banner -->
                        <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,14"
                                Visibility="{Binding ValidationMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ValidationMessage}" FontWeight="SemiBold" FontSize="11.5" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Button Command="{Binding ActivateLicenseCommand}" Content="✓ Verify Signature &amp; Activate 1-Year License" 
                                Style="{StaticResource SuccessButton}" FontSize="13.5" Padding="20,11" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <!-- Row 3: Footer -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="100% Offline Cryptographic System • Zero Internet Connection Required on this PC" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
