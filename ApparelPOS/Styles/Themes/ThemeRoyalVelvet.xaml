<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Royal Velvet Theme -->
    <!-- Brand & Accent Colors -->
    <Color x:Key="PrimaryColor">#9333EA</Color>
    <Color x:Key="PrimaryHoverColor">#7E22CE</Color>
    <Color x:Key="PrimaryLightColor">#C084FC</Color>
    
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessHoverColor">#059669</Color>
    
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#E11D48</Color>
    <Color x:Key="DangerHoverColor">#BE123C</Color>

    <!-- Backgrounds & Surfaces -->
    <Color x:Key="BgDarkColor">#150D22</Color>
    <Color x:Key="BgCardColor">#221437</Color>
    <Color x:Key="BgCardHoverColor">#311D4F</Color>
    <Color x:Key="BgInputColor">#0D0716</Color>
    <Color x:Key="BorderColor">#3E2363</Color>
    <Color x:Key="BorderLightColor">#59328E</Color>

    <!-- Typography -->
    <Color x:Key="TextPrimaryColor">#FAF5FF</Color>
    <Color x:Key="TextSecondaryColor">#D8B4FE</Color>
    <Color x:Key="TextMutedColor">#A855F7</Color>

    <!-- Badges & Tables -->
    <Color x:Key="TableAlternateRowColor">#1C102E</Color>
    <Color x:Key="AccentBadgeBgColor">#3B0764</Color>
    <Color x:Key="AccentBadgeTextColor">#F3E8FF</Color>
    <Color x:Key="KeyBadgeBgColor">#2C1A47</Color>
    <Color x:Key="KeyBadgeBorderColor">#482A73</Color>
    <Color x:Key="KeyBadgeTextColor">#FAF5FF</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHoverColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}"/>

    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <SolidColorBrush x:Key="TableAlternateRowBrush" Color="{StaticResource TableAlternateRowColor}"/>
    <SolidColorBrush x:Key="AccentBadgeBgBrush" Color="{StaticResource AccentBadgeBgColor}"/>
    <SolidColorBrush x:Key="AccentBadgeTextBrush" Color="{StaticResource AccentBadgeTextColor}"/>
    <SolidColorBrush x:Key="KeyBadgeBgBrush" Color="{StaticResource KeyBadgeBgColor}"/>
    <SolidColorBrush x:Key="KeyBadgeBorderBrush" Color="{StaticResource KeyBadgeBorderColor}"/>
    <SolidColorBrush x:Key="KeyBadgeTextBrush" Color="{StaticResource KeyBadgeTextColor}"/>
</ResourceDictionary>

